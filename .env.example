# ============================================================
# BIST Telegram Sinyal Botu — .env.example
# Bu dosyayı kopyala → ".env" olarak kaydet → gerçek değerleri gir
# .env dosyasını asla Git'e commit etme!
# ============================================================

# --- Telegram ---
TELEGRAM_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_chat_id_here

# --- (Opsiyonel) LLM API — KAP filtresi için ---
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_claude_key_here

# --- Aracı Kurum Komisyon Oranı ---
# Gerçek kullandığın aracı kurum oranını gir (örn. 0.001 = %0.1)
KOMISYON_ORANI=0.001
